# ====================================================================
# Vorlage – kopieren nach .env und Werte anpassen:
#   cp .env.example .env
# (.env ist absichtlich NICHT im Repo, da lokale Passwörter.)
# ====================================================================

# --- Ports (im Browser erreichbar) ---
WP_PORT=8080          # WordPress:  http://localhost:8080
ADMINER_PORT=8081     # Datenbank:  http://localhost:8081

# --- Datenbank ---
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root_geheim

# --- WordPress-Debug (1 = an, lokal praktisch) ---
WP_DEBUG=1

# --- WordPress-Installation (wird beim Setup angelegt) ---
WP_URL=http://localhost:8080
WP_TITLE="FC Schattdorf"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin123
WP_ADMIN_EMAIL=dein.name@example.com
