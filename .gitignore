# lokale Geheimnisse / Umgebung
.env

# WordPress-Core & Uploads (liegen im Docker-Volume, nicht im Repo)
wp-content/uploads/
wp-content/plugins/
wp-content/themes/*/
!wp-content/themes/fcschattdorf-child/

# Hinweis: import/ enthält urheberrechtlich geschützte Original-Assets
# der fcschattdorf.ch-Website. Wird NUR ins PRIVATE Repo eingecheckt –
# niemals öffentlich machen!

# OS
.DS_Store

# Backup des alten WordPress-Standes (298 MB, nicht Teil der Repo-Historie)
wp-content-backup/

# Next.js Dev-Cache (Build-Artefakt, kein Projektcode)
.next/
