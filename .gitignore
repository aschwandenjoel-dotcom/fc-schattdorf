# lokale Geheimnisse / Umgebung
.env

# WordPress-Core & Uploads (liegen im Docker-Volume, nicht im Repo)
wp-content/uploads/
wp-content/plugins/
wp-content/themes/*/
!wp-content/themes/fcschattdorf-child/

# Hinweis: import/ enthält urheberrechtlich geschützte Original-Assets
# der fcschattdorf.ch-Website. Wird NUR ins PRIVATE Repo eingecheckt –
# niemals öffentlich machen!

# Lokale Backups (DB + Uploads, siehe scripts/backup.sh)
# backups/* statt backups/, damit die Ausnahme darunter greifen kann
backups/*
# Ausnahme: abgelegte Code-Schnipsel entfernter Abschnitte (kein Geheimnis,
# soll später wieder eingebaut werden können)
!backups/snippets/
!backups/snippets/**

# Deploy-Paket für Hostpoint (enthält DB-Dump und Salts – nie einchecken)
# deploy/* statt deploy/, damit die Ausnahme darunter greifen kann
deploy/*
# Ausnahme: Export-Vorlage ohne Geheimnisse — wird von scripts/pull-prod-db.sh gebraucht
!deploy/fcs-db-export.php.tpl
# Ausnahme: Import-Vorlage + Deploy-Skript des Grümpelturnier-News-Beitrags
# (Token wird erst beim Deploy eingesetzt, enthält selbst keine Geheimnisse)
!deploy/fcs-import-gruempi.php.tpl
!deploy/deploy-gruempi.sh
# Ausnahme: Beitragsbild-Umstellung des Grümpelturnier-Beitrags
!deploy/fcs-set-gruempi-thumb.php.tpl
!deploy/deploy-gruempi-thumb.sh
# Ausnahme: Theme-Deploy der Trainingslager-Seite (enthaelt keine Geheimnisse)
!deploy/deploy-trainingslager.sh
# Ausnahme: Theme-Deploy der Titelbilder auf den Teamseiten (keine Geheimnisse)
!deploy/deploy-team-titelbilder.sh

# OS
.DS_Store

# Backup des alten WordPress-Standes (298 MB, nicht Teil der Repo-Historie)
wp-content-backup/

# Next.js Dev-Cache (Build-Artefakt, kein Projektcode)
.next/

# Recovery-Artefakte (gerettete DB + Uploads, 478 MB, nicht Teil der Historie)
/backup/
