# lokale Geheimnisse / Umgebung
.env

# WordPress-Core & Uploads (liegen im Docker-Volume, nicht im Repo)
wp-content/uploads/
wp-content/plugins/
wp-content/themes/*/
!wp-content/themes/fcschattdorf-child/

# Hinweis: import/ enthält urheberrechtlich geschützte Original-Assets
# der fcschattdorf.ch-Website. Wird NUR ins PRIVATE Repo eingecheckt –
# niemals öffentlich machen!

# Lokale Backups (DB + Uploads, siehe scripts/backup.sh)
# backups/* statt backups/, damit die Ausnahme darunter greifen kann
backups/*
# Ausnahme: abgelegte Code-Schnipsel entfernter Abschnitte (kein Geheimnis,
# soll später wieder eingebaut werden können)
!backups/snippets/
!backups/snippets/**

# Deploy-Paket für Hostpoint (enthält DB-Dump und Salts – nie einchecken)
# deploy/* statt deploy/, damit die Ausnahme darunter greifen kann
deploy/*
# Ausnahme: Export-Vorlage ohne Geheimnisse — wird von scripts/pull-prod-db.sh gebraucht
!deploy/fcs-db-export.php.tpl
# Ausnahme: Import-Vorlage + Deploy-Skript des Grümpelturnier-News-Beitrags
# (Token wird erst beim Deploy eingesetzt, enthält selbst keine Geheimnisse)
!deploy/fcs-import-gruempi.php.tpl
!deploy/deploy-gruempi.sh
# Ausnahme: Beitragsbild-Umstellung des Grümpelturnier-Beitrags
!deploy/fcs-set-gruempi-thumb.php.tpl
!deploy/deploy-gruempi-thumb.sh
# Ausnahme: Theme-Deploy der Trainingslager-Seite (enthaelt keine Geheimnisse)
!deploy/deploy-trainingslager.sh
# Ausnahme: Theme-Deploy der Darstellungsfehler auf grossen Bildschirmen
!deploy/deploy-monitor-fixes.sh
# Ausnahme: Deploy des Design-Stands (Top-Club-88-Stil) mit seinen beiden
# DB-Vorlagen — Token wird erst beim Deploy eingesetzt, keine Geheimnisse
!deploy/deploy-designstand.sh
!deploy/fcs-junioren-teams.php.tpl
!deploy/fcs-junioren-seiten.php.tpl
# Ausnahme: Theme-Deploy der Responsiv-Anpassungen Kontakt/Helfereinsaetze
!deploy/deploy-responsiv-kontakt-helfer.sh
# Ausnahme: Inhalte für den Domainwechsel (A7: Descriptions, Standardbild,
# Datenschutz) — Token wird erst beim Deploy eingesetzt, keine Geheimnisse
!deploy/deploy-a7-inhalte.sh
!deploy/fcs-a7-inhalte.php.tpl
# Ausnahme: Impressum-Anpassung (Webdesign: Urinet Aschwanden)
!deploy/deploy-impressum.sh
!deploy/fcs-impressum-update.php.tpl
# Ausnahme: Schiedsrichter-Stand (zwei neue SR + Spielleiter-Liste);
# Token wird erst beim Deploy eingesetzt, enthaelt selbst keine Geheimnisse
!deploy/deploy-schiedsrichter.sh
!deploy/fcs-schiedsrichter-update.php.tpl
# Ausnahme: Redaktions-Rueckmeldungen Vorrunde 26/27 (Theme + DB);
# Token wird erst beim Deploy eingesetzt, enthaelt selbst keine Geheimnisse
!deploy/deploy-redaktion-vorrunde-2627.sh
!deploy/fcs-redaktion-vorrunde-2627.php.tpl
# Ausnahme: Liste der verkleinerten Bilder (nur Dateinamen, keine Geheimnisse)
!deploy/verkleinerte-bilder.txt
# Ausnahme: News-Nachtrag von der alten Vereinsseite (Token wird erst beim
# Deploy eingesetzt; die JSON-Liste enthaelt nur veroeffentlichte Inhalte)
!deploy/deploy-news-import-0926.sh
!deploy/fcs-news-import-0926.php.tpl
!deploy/news-import-0926.json
# Ausnahme: 1. Mannschaft Vorrunde 26/27 (Betreuerstab, Kader, Kopfsponsoren);
# Token wird erst beim Deploy eingesetzt, enthaelt selbst keine Geheimnisse
!deploy/deploy-1mannschaft-vorrunde-2627.sh
!deploy/fcs-1mannschaft-vorrunde-2627.php.tpl
# Ausnahme: 3. Mannschaft, neues Mannschaftsfoto + Teamsponsor Feritec AG;
# Token wird erst beim Deploy eingesetzt, enthaelt selbst keine Geheimnisse
!deploy/deploy-3mannschaft-feritec.sh
!deploy/fcs-3mannschaft-feritec.php.tpl
# Ausnahme: Vorstandsseite bindet Vorschaubilder statt Originale ein;
# Token wird erst beim Deploy eingesetzt, enthaelt selbst keine Geheimnisse
!deploy/deploy-vorstand-bilder.sh
!deploy/fcs-vorstand-bilder.php.tpl

# OS
.DS_Store

# Backup des alten WordPress-Standes (298 MB, nicht Teil der Repo-Historie)
wp-content-backup/

# Next.js Dev-Cache (Build-Artefakt, kein Projektcode)
.next/

# Recovery-Artefakte (gerettete DB + Uploads, 478 MB, nicht Teil der Historie)
/backup/

# Ausgangsmaterial der Redaktion (Bildschirmfotos der Sponsorenlogos vom
# 05.09.2026). Die daraus abgeleiteten Dateien liegen in uploads/.
Spielersponsoren-Logo/
